<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <AssemblyName>Wallhaven</AssemblyName><RootNamespace>Wallhaven.Desktop</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon><Version>1.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Wallhaven.Core/Wallhaven.Core.csproj" /></ItemGroup>
</Project>
